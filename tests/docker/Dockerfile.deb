# e2e: install the built .deb on Ubuntu and run the full test cycle.
FROM ubuntu:24.04
ARG VERSION=0.0.0
ARG DEBIAN_FRONTEND=noninteractive
COPY dist/asb_${VERSION}_all.deb /tmp/asb.deb
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/asb.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/asb.deb
RUN useradd -m -s /bin/bash dev \
    && echo 'dev ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/dev
# COPY preserves the host's bits, for the script and for the parent directory
# it creates. On a checkout that has been through 'asb lockdown' (go-rwx across
# $HOME) both land 0770 root-owned, and the unprivileged 'dev' user can neither
# read the script nor enter its directory. Pin both.
COPY tests/e2e.sh /usr/local/share/asb-tests/e2e.sh
RUN chmod 0755 /usr/local/share/asb-tests /usr/local/share/asb-tests/e2e.sh
USER dev
WORKDIR /home/dev
CMD ["bash", "/usr/local/share/asb-tests/e2e.sh"]
