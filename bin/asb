#!/usr/bin/env bash
# asb — agent sandbox. Run AI coding agents as locked-down OS accounts.
#
# A sandbox is a named isolated environment backed by a dedicated OS account.
# asb creates sandboxes, grants them access to specific project directories
# via POSIX ACLs, and launches agents inside them. The kernel enforces the
# boundary; there is no application-level allowlist to misparse or disable.
set -euo pipefail

ASB_VERSION="0.0.0-dev"

# $USER is not guaranteed by POSIX (absent in some containers/cron)
USER="${USER:-$(id -un)}"

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/asb"
CONFIG_FILE="$CONFIG_ROOT/config"
AGENTS_FILE="$CONFIG_ROOT/agents.conf"
OS=$(uname -s)
SUDOERS_DIR="/etc/sudoers.d"

SANDBOX_OVERRIDE=""
ASSUME_YES="${ASB_ASSUME_YES:-}"

# ---------------------------------------------------------------- utilities

die()  { printf 'asb: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'asb: warning: %s\n' "$*" >&2; }
info() { printf '%s\n' "$*"; }

confirm() {
    [[ -n "$ASSUME_YES" ]] && return 0
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" == y || "$reply" == Y ]]
}

usage() {
    cat <<EOF
asb $ASB_VERSION — run AI coding agents in kernel-enforced sandboxes

Usage: asb [-s <sandbox>] [-y] <command> [args]

Sandboxes:
  create <name> [--agent <agent>] [--install|--no-install]
                                    Create a sandbox (a dedicated OS account)
                                    and offer to install its agent CLI
  delete <name> [--purge]           Delete a sandbox (--purge also removes its home)
  use <name>                        Set the default sandbox
  list [name]                       Show sandboxes and their granted directories

Directory grants (apply to the default sandbox, or -s <sandbox>):
  add [dir]                         Grant access to a directory (default: .)
  remove [dir]                      Revoke access to a directory (default: .)
  recover                           Re-apply all grants from config (after ACL loss)

Running agents:
  launch [sandbox] [agent] [-- args]
                                    Launch an agent here, inside a sandbox.
                                    Everything is defaultable: 'asb launch' uses
                                    the default sandbox and its default agent.

Working inside a sandbox:
  run [--here] <command...>         Run a command as the sandbox, in its home.
                                    --here runs in the current directory, which
                                    must be granted. Installing an agent CLI:
                                      asb run 'curl -fsSL https://claude.ai/install.sh | bash'
  shell                             Open an interactive shell in the sandbox

Host hardening & diagnostics:
  lockdown                          chmod go-rwx your \$HOME + set umask 077
  doctor                            Check ACL support, sudoers, agent availability

Options:
  -s <sandbox>    Use this sandbox instead of the default
  -y, --yes       Assume yes on confirmation prompts
  -h, --help      Show this help
  --version       Print version

Config: $CONFIG_ROOT
Agents: $AGENTS_FILE (one per line: name=command line)
EOF
}

ensure_config() {
    mkdir -p "$CONFIG_ROOT"
    [[ -f "$CONFIG_FILE" ]] || : > "$CONFIG_FILE"
    if [[ ! -f "$AGENTS_FILE" ]]; then
        cat > "$AGENTS_FILE" <<'EOF'
# asb agents: one per line, name=command line to run inside the sandbox.
# The command runs as the sandbox account, in the current project directory.
# Permission-prompt skipping is a per-agent choice — the OS boundary holds
# either way, so pick per agent what you are comfortable with.
claude=claude --dangerously-skip-permissions
claude-safe=claude
hermes=hermes --yolo
EOF
    fi
}

config_get() {  # config_get <file> <key>
    [[ -f "$1" ]] || return 0
    sed -n "s/^$2=//p" "$1" | tail -n 1
}

config_set() {  # config_set <file> <key> <value>
    local tmp
    tmp=$(mktemp)
    {
        if [[ -f "$1" ]]; then grep -v "^$2=" "$1" || true; fi
        printf '%s=%s\n' "$2" "$3"
    } > "$tmp"
    mv "$tmp" "$1"
}

sandbox_exists() { [[ -d "$CONFIG_ROOT/$1" ]]; }

all_sandboxes() {
    local d
    for d in "$CONFIG_ROOT"/*/; do
        [[ -d "$d" ]] || continue
        basename "$d"
    done
}

# Resolve the sandbox to operate on: -s flag, else default_sandbox.
current_sandbox() {
    local sb="${SANDBOX_OVERRIDE:-$(config_get "$CONFIG_FILE" default_sandbox)}"
    [[ -n "$sb" ]] || die "no sandbox selected. Create one with 'asb create <name>' or pick one with 'asb use <name>'."
    sandbox_exists "$sb" || die "unknown sandbox '$sb'. See 'asb list'."
    printf '%s' "$sb"
}

grant_file() { printf '%s/%s/directories' "$CONFIG_ROOT" "$1"; }

agent_command() {  # agent_command <agent-name>
    local cmd
    cmd=$(sed -n "s/^$1=//p" "$AGENTS_FILE" | tail -n 1)
    [[ -n "$cmd" ]] || die "unknown agent '$1'. Known agents: $(agent_names | paste -sd' ' -)"
    printf '%s' "$cmd"
}

agent_names() { sed -n 's/^\([A-Za-z0-9_-]\+\)=.*/\1/p' "$AGENTS_FILE"; }

# The executable an agent runs: the first word of its command line.
agent_binary() { agent_command "$1" | awk '{print $1}'; }

# How to fetch an agent CLI we know about, keyed on the binary rather than the
# agent name so 'claude', 'claude-safe' and any user-defined variant match.
# The command runs inside the sandbox, so curl is the sandbox's dependency.
agent_installer() {  # agent_installer <binary>
    case "$1" in
        claude) printf '%s' 'curl -fsSL https://claude.ai/install.sh | bash' ;;
    esac
}

default_agent_for() {  # default_agent_for <sandbox>
    local agent
    agent=$(config_get "$CONFIG_ROOT/$1/config" agent)
    [[ -n "$agent" ]] || agent=$(config_get "$CONFIG_FILE" default_agent)
    # awk, not 'head -n 1': head exits after one line and the producer takes
    # SIGPIPE, which pipefail turns into a fatal error under set -e.
    [[ -n "$agent" ]] || agent=$(agent_names | awk 'NR==1')
    [[ -n "$agent" ]] || die "no agents configured in $AGENTS_FILE"
    printf '%s' "$agent"
}

# Run a shell command as the sandbox account. -i gives a login shell, so the
# sandbox's own PATH (agents install into ~/.local/bin) applies; -n keeps
# checks non-interactive.
sandbox_sh() {  # sandbox_sh [-n] <sandbox> <shell-command>
    if [[ "$1" == "-n" ]]; then
        shift
        sudo -n -u "$1" -i bash -lc "$2"
    else
        sudo -u "$1" -i bash -lc "$2"
    fi
}

# ------------------------------------------------------------- ACL plumbing

# Order matters on Linux: chmod on a tree that already has ACLs rewrites the
# ACL mask (the group bits ARE the mask), so we always tighten with chmod
# FIRST and grant with setfacl SECOND — setfacl recalculates the mask.

tighten_subtree() {
    info "Tightening permissions (go-rwx) on: $1"
    # Files created by the sandbox belong to its account and cannot be
    # chmod'ed by us; they inherit private permissions from the default ACL,
    # so skipping them is safe.
    chmod -R go-rwx "$1" 2>/dev/null || \
        warn "some files in $1 are owned by other accounts and were left unchanged"
}

apply_grants() {  # apply_grants <acct> <dir>
    local acct="$1" dir="$2"
    info "Granting $acct access to: $dir"
    if [[ "$OS" == Darwin ]]; then
        local path failed=0
        local dir_perms="read,write,execute,delete,append,add_file,add_subdirectory,delete_child,list,search,readattr,writeattr,readextattr,writeextattr,readsecurity,file_inherit,directory_inherit"
        local file_perms="read,write,execute,delete,append,readattr,writeattr,readextattr,writeextattr,readsecurity"
        while IFS= read -r -d '' path; do
            macos_acl_set "$path" "$acct" "user:$acct allow $dir_perms" || failed=1
            macos_acl_set "$path" "$USER" "user:$USER allow $dir_perms" || failed=1
        done < <(find "$dir" -type d -print0)
        while IFS= read -r -d '' path; do
            macos_acl_set "$path" "$acct" "user:$acct allow $file_perms" || failed=1
            macos_acl_set "$path" "$USER" "user:$USER allow $file_perms" || failed=1
        done < <(find "$dir" -type f -print0)
        if [[ "$failed" -eq 1 ]]; then
            warn "some files in $dir could not be updated (they may be owned by the sandbox)"
        fi
        local acl
        acl=$(ls -lde "$dir" 2>/dev/null) || true
        grep -Fq "user:$acct allow $dir_perms" <<< "$acl" || \
            die "failed to apply ACLs on $dir (filesystem without ACL support?)"
        return
    fi
    # Files created by the sandbox are owned by its account and cannot be
    # re-ACL'ed by us; they already carry both ACLs via inheritance.
    setfacl -R -m "u:$acct:rwX,d:u:$acct:rwX,u:$USER:rwX,d:u:$USER:rwX" "$dir" 2>/dev/null || \
        warn "files not owned by you kept their existing ACLs"
    # Capture before matching: 'grep -q' exits mid-stream, getfacl takes SIGPIPE
    # and pipefail would report that as a missing ACL.
    local acl
    acl=$(getfacl -p "$dir" 2>/dev/null) || true
    grep -q "^user:$acct:" <<< "$acl" || \
        die "failed to apply ACLs on $dir (filesystem without ACL support?)"
}

remove_grants() {  # remove_grants <acct> <dir>
    local acct="$1" dir="$2"
    info "Revoking $acct access to: $dir"
    if [[ "$OS" == Darwin ]]; then
        local path
        while IFS= read -r -d '' path; do
            macos_acl_remove "$path" "$acct"
        done < <(find "$dir" -print0)
        return
    fi
    setfacl -R -x "u:$acct" "$dir" 2>/dev/null || true
    setfacl -R -d -x "u:$acct" "$dir" 2>/dev/null || true
}

macos_acl_remove() {  # macos_acl_remove <path> <account>
    local path="$1" account="$2" entries index
    # ls -le is macOS's interface for inspecting ACL entries.
    # shellcheck disable=SC2012
    entries=$(ls -lde "$path" 2>/dev/null | awk -v principal="user:$account " '
        /^[[:space:]]*[0-9]+:/ {
            line=$0
            sub(/^[[:space:]]*[0-9]+: /, "", line)
            if (index(line, principal) == 1) {
                number=$1
                sub(/:$/, "", number)
                print number
            }
        }' | sort -rn) || return 0
    while IFS= read -r index; do
        if [[ -n "$index" ]]; then
            chmod -a# "$index" "$path" 2>/dev/null || true
        fi
    done <<< "$entries"
}

macos_acl_set() {  # macos_acl_set <path> <account> <entry>
    local path="$1" account="$2" entry="$3" acl
    acl=$(ls -lde "$path" 2>/dev/null) || return 1
    grep -Fq "$entry" <<< "$acl" && return 0
    macos_acl_remove "$path" "$account"
    chmod +a "$entry" "$path" 2>/dev/null
}

file_mode() {  # file_mode <path>
    if [[ "$OS" == Darwin ]]; then
        stat -f "%Lp" "$1"
    else
        stat -c "%a" "$1"
    fi
}

canonical_dir() {  # canonical_dir <dir>
    (cd -- "$1" 2>/dev/null && pwd -P)
}

account_home() {  # account_home <account>
    if [[ "$OS" == Darwin ]]; then
        dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null |
            sed 's/^NFSHomeDirectory: //'
    else
        getent passwd "$1" | cut -d: -f6
    fi
}

create_account() {  # create_account <name>
    if [[ "$OS" == Darwin ]]; then
        sudo sysadminctl -addUser "$1" -fullName "asb sandbox" \
            -home "/Users/$1" -shell /bin/bash -password '*'
    else
        sudo useradd --create-home --user-group --shell /bin/bash \
            --comment "asb sandbox" "$1"
    fi
}

delete_account() {  # delete_account <name> <home>
    if [[ "$OS" == Darwin ]]; then
        sudo sysadminctl -deleteUser "$1"
        if [[ -d "$2" ]]; then
            sudo rm -rf "$2"
        fi
    else
        sudo userdel -r "$1"
    fi
}

sudoers_group() {
    [[ "$OS" == Darwin ]] && printf wheel || printf root
}

# Give the sandbox account traverse (--x) on every parent directory that it
# cannot already search, so it can reach the project without reading siblings.
apply_parent_traverse() {  # apply_parent_traverse <acct> <dir>
    local acct="$1" current="$2" mode other
    while true; do
        current=$(dirname "$current")
        [[ "$current" == "/" ]] && break
        mode=$(file_mode "$current" 2>/dev/null) || continue
        other="${mode: -1}"
        # world-execute already allows traversal
        (( other & 1 )) && continue
        if [[ "$OS" == Darwin ]]; then
            macos_acl_set "$current" "$acct" "user:$acct allow search,execute" || \
                sudo -n chmod +a "user:$acct allow search,execute" "$current" 2>/dev/null || \
                warn "could not add traverse permission on $current — $acct may be unable to reach the project"
        elif ! setfacl -m "u:$acct:--x" "$current" 2>/dev/null; then
            if ! sudo -n setfacl -m "u:$acct:--x" "$current" 2>/dev/null; then
                warn "could not add traverse permission on $current — $acct may be unable to reach the project"
            fi
        fi
    done
}

# Warn when a parent directory is world-readable: the sandbox account could
# enumerate it and see sibling directories, defeating per-project isolation.
check_parent_exposure() {  # check_parent_exposure <dir>
    local current="$1" mode other exposed=()
    while true; do
        current=$(dirname "$current")
        [[ "$current" == "/" || "$current" == "$HOME" ]] && break
        mode=$(file_mode "$current" 2>/dev/null) || continue
        other="${mode: -1}"
        (( other & 4 )) && exposed+=("$current (mode $mode)")
    done
    if [[ ${#exposed[@]} -gt 0 ]]; then
        warn "parent directories are world-readable; sandboxes can list them and read any world-readable siblings:"
        local p
        for p in "${exposed[@]}"; do
            printf '    %s\n' "$p" >&2
        done
        printf '  To close the gap: chmod go-rwx <dir> (or run: asb lockdown)\n' >&2
    fi
}

resolve_dir() {
    local dir="${1:-.}"
    canonical_dir "$dir" || die "cannot resolve directory: $dir"
}

# Refuse to work in a directory the sandbox has not been granted.
require_granted() {  # require_granted <sandbox> <dir>
    local sb="$1" dir="$2" gf entry resolved
    gf=$(grant_file "$sb")
    [[ -s "$gf" ]] || die "no directories granted to '$sb'. Run 'asb add' in your project first."
    while IFS= read -r entry; do
        resolved=$(canonical_dir "$entry") || continue
        if [[ "$dir" == "$resolved" || "$dir" == "$resolved"/* ]]; then
            return 0
        fi
    done < "$gf"
    {
        printf 'asb: error: %s is not granted to sandbox %s.\n' "$dir" "$sb"
        printf 'Granted directories:\n'
        sed 's/^/    /' "$gf"
        printf "To grant it: asb -s %s add\n" "$sb"
    } >&2
    exit 1
}

# ---------------------------------------------------------------- commands

# Install an agent CLI inside a sandbox, if we know how and the user agrees.
# Never runs unattended: with no TTY (scripts, CI) we skip and let the caller
# print the command instead — -y must not silently start a network install.
install_agent_into() {  # install_agent_into <sandbox> <binary> <installer> <yes|no|"">
    local sb="$1" bin="$2" installer="$3" choice="$4"
    if sandbox_sh -n "$sb" "command -v $(printf '%q' "$bin")" >/dev/null 2>&1; then
        info "'$bin' is already installed in sandbox '$sb'."
        return 0
    fi
    [[ "$choice" == no ]] && return 1
    if [[ -z "$installer" ]]; then
        [[ "$choice" == yes ]] &&
            warn "no built-in installer for '$bin' — install it with: asb -s $sb run '<command>'"
        return 1
    fi
    if [[ "$choice" != yes ]]; then
        [[ -t 0 ]] || return 1
        # Deliberately not confirm(): -y/ASB_ASSUME_YES must never auto-approve
        # a network install. --install is the explicit, scriptable opt-in.
        local reply
        read -r -p "Install '$bin' in sandbox '$sb' now? [y/N] " reply || reply=""
        [[ "$reply" == y || "$reply" == Y ]] || return 1
    fi
    info "Installing '$bin' in sandbox '$sb'…"
    if sandbox_sh "$sb" "$installer"; then
        info "'$bin' installed in '$sb'."
        return 0
    fi
    warn "installing '$bin' failed — retry with: asb -s $sb run '$installer'"
    return 1
}

cmd_create() {
    local name="" agent="" install="" arg
    while [[ $# -gt 0 ]]; do
        arg="$1"; shift
        case "$arg" in
            --agent) agent="${1:-}"; shift || true ;;
            --install) install=yes ;;
            --no-install) install=no ;;
            -*) die "unknown option for create: $arg" ;;
            *) if [[ -z "$name" ]]; then name="$arg"; else die "create takes one name"; fi ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: asb create <name> [--agent <agent>] [--install|--no-install]"
    [[ "$name" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid sandbox name '$name' (lowercase letters, digits, - and _)"
    sandbox_exists "$name" && die "sandbox '$name' already exists"
    ensure_config
    [[ -n "$agent" ]] && agent_command "$agent" >/dev/null   # validate early

    if id "$name" >/dev/null 2>&1; then
        info "OS account '$name' already exists; adopting it."
    else
        info "Creating OS account '$name' (needs sudo)…"
        create_account "$name"
    fi
    local home
    home=$(account_home "$name")
    [[ -n "$home" ]] || die "could not determine home directory for OS account '$name'"
    sudo chmod 700 "$home"

    # Passwordless one-way door: invoker -> sandbox account. Nothing else.
    local rule tmp
    rule=$(printf '%s ALL=(%s) NOPASSWD: ALL\n' "$USER" "$name")
    tmp=$(mktemp)
    printf '%s\n' "$rule" > "$tmp"
    sudo visudo -cf "$tmp" >/dev/null || { rm -f "$tmp"; die "generated sudoers rule failed validation"; }
    sudo mkdir -p "$SUDOERS_DIR"
    sudo install -m 0440 -o root -g "$(sudoers_group)" "$tmp" "$SUDOERS_DIR/asb-$name"
    rm -f "$tmp"

    mkdir -p "$CONFIG_ROOT/$name"
    : > "$(grant_file "$name")"
    [[ -n "$agent" ]] && config_set "$CONFIG_ROOT/$name/config" agent "$agent"
    if [[ -z "$(config_get "$CONFIG_FILE" default_sandbox)" ]]; then
        config_set "$CONFIG_FILE" default_sandbox "$name"
        info "'$name' is now the default sandbox."
    fi

    local sb_agent bin="" installer="" installed=""
    sb_agent=$(default_agent_for "$name" 2>/dev/null || true)
    if [[ -n "$sb_agent" ]]; then
        bin=$(agent_binary "$sb_agent" 2>/dev/null || true)
        [[ -n "$bin" ]] && installer=$(agent_installer "$bin")
    fi
    if [[ -n "$bin" ]] && install_agent_into "$name" "$bin" "$installer" "$install"; then
        installed=1
    fi

    local step=1
    printf "\nSandbox '%s' created.\n\nNext steps:\n" "$name"
    if [[ -z "$installed" ]]; then
        printf '  %d. Install the agent CLI inside it:\n' "$step"; step=$((step+1))
        printf "       asb -s %s run '%s'\n" "$name" "${installer:-<install command>}"
    fi
    printf '  %d. Grant it a project:   cd ~/code/my-project && asb add\n' "$step"; step=$((step+1))
    printf '  %d. Launch:               asb launch %s\n' "$step" "$name"
}

cmd_delete() {
    local name="" purge="" arg
    while [[ $# -gt 0 ]]; do
        arg="$1"; shift
        case "$arg" in
            --purge) purge=1 ;;
            -*) die "unknown option for delete: $arg" ;;
            *) if [[ -z "$name" ]]; then name="$arg"; else die "delete takes one name"; fi ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: asb delete <name> [--purge]"
    sandbox_exists "$name" || die "unknown sandbox '$name'"

    confirm "Delete sandbox '$name'${purge:+ AND its OS account + home directory}?" \
        || die "aborted"

    # Best-effort: drop this sandbox's ACLs from its granted directories.
    local dir
    while IFS= read -r dir; do
        [[ -d "$dir" ]] && remove_grants "$name" "$dir"
    done < "$(grant_file "$name")"

    sudo rm -f "$SUDOERS_DIR/asb-$name"
    rm -rf "${CONFIG_ROOT:?}/$name"
    if [[ -n "$purge" ]] && id "$name" >/dev/null 2>&1; then
        delete_account "$name" "$(account_home "$name")"
        info "OS account '$name' and its home removed."
    fi
    if [[ "$(config_get "$CONFIG_FILE" default_sandbox)" == "$name" ]]; then
        config_set "$CONFIG_FILE" default_sandbox ""
        warn "'$name' was the default sandbox; pick a new one with 'asb use <name>'."
    fi
    info "Sandbox '$name' deleted."
}

cmd_use() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "usage: asb use <name>"
    sandbox_exists "$name" || die "unknown sandbox '$name'. See 'asb list'."
    ensure_config
    config_set "$CONFIG_FILE" default_sandbox "$name"
    info "Default sandbox: $name"
}

cmd_list() {
    local only="${1:-}" sb default gf dir agent
    default=$(config_get "$CONFIG_FILE" default_sandbox)
    local found=""
    for sb in $(all_sandboxes); do
        [[ -n "$only" && "$sb" != "$only" ]] && continue
        found=1
        agent=$(default_agent_for "$sb" 2>/dev/null || echo "?")
        if [[ "$sb" == "$default" ]]; then
            printf '%s (default, agent: %s)\n' "$sb" "$agent"
        else
            printf '%s (agent: %s)\n' "$sb" "$agent"
        fi
        gf=$(grant_file "$sb")
        if [[ -s "$gf" ]]; then
            while IFS= read -r dir; do printf '    %s\n' "$dir"; done < "$gf"
        else
            printf '    (no directories granted)\n'
        fi
    done
    if [[ -z "$found" ]]; then
        if [[ -n "$only" ]]; then
            die "unknown sandbox '$only'"
        else
            info "No sandboxes yet. Create one with: asb create <name>"
        fi
    fi
}

cmd_add() {
    local sb dir gf
    sb=$(current_sandbox)
    dir=$(resolve_dir "${1:-.}")
    [[ -d "$dir" ]] || die "not a directory: $dir"
    gf=$(grant_file "$sb")
    if grep -qxF "$dir" "$gf" 2>/dev/null; then
        info "Already granted (re-applying permissions): $dir"
    else
        printf '%s\n' "$dir" >> "$gf"
        info "Granted to $sb: $dir"
    fi
    tighten_subtree "$dir"
    apply_grants "$sb" "$dir"
    apply_parent_traverse "$sb" "$dir"
    check_parent_exposure "$dir"
}

cmd_remove() {
    local sb dir gf tmp
    sb=$(current_sandbox)
    dir=$(resolve_dir "${1:-.}")
    gf=$(grant_file "$sb")
    if grep -qxF "$dir" "$gf" 2>/dev/null; then
        tmp=$(mktemp)
        grep -vxF "$dir" "$gf" > "$tmp" || true
        mv "$tmp" "$gf"
        remove_grants "$sb" "$dir"
        info "Removed from $sb: $dir"
    else
        die "not in the grant list for $sb: $dir"
    fi
}

cmd_recover() {
    local sb dir gf
    sb=$(current_sandbox)
    gf=$(grant_file "$sb")
    [[ -s "$gf" ]] || die "no directories configured for $sb"
    while IFS= read -r dir; do
        if [[ -d "$dir" ]]; then
            tighten_subtree "$dir"
            apply_grants "$sb" "$dir"
            apply_parent_traverse "$sb" "$dir"
        else
            warn "skipping missing directory: $dir"
        fi
    done < "$gf"
    info "Re-applied all grants for $sb."
}

cmd_launch() {
    local sb="" agent="" extra=() arg
    while [[ $# -gt 0 ]]; do
        arg="$1"; shift
        case "$arg" in
            --) extra=("$@"); break ;;
            -*) die "unknown option for launch: $arg (pass agent args after --)" ;;
            *)
                if [[ -z "$sb" && -z "$agent" ]]; then
                    # First positional: sandbox if known, else agent.
                    if sandbox_exists "$arg" && grep -q "^$arg=" "$AGENTS_FILE" 2>/dev/null; then
                        die "'$arg' names both a sandbox and an agent — rename one, or use: asb -s $arg launch $arg"
                    elif sandbox_exists "$arg"; then
                        sb="$arg"
                    else
                        agent="$arg"
                    fi
                elif [[ -z "$agent" ]]; then
                    agent="$arg"
                else
                    die "too many arguments; pass agent args after --"
                fi
                ;;
        esac
    done
    ensure_config
    [[ -n "$sb" ]] || sb=$(current_sandbox)
    sandbox_exists "$sb" || die "unknown sandbox '$sb'"
    [[ -n "$agent" ]] || agent=$(default_agent_for "$sb")
    local agent_cmd
    agent_cmd=$(agent_command "$agent")

    local cwd
    cwd=$(pwd -P)
    require_granted "$sb" "$cwd"

    local extra_q=""
    [[ ${#extra[@]} -gt 0 ]] && extra_q=$(printf ' %q' "${extra[@]}")
    info "Launching $agent as sandbox '$sb' in $cwd"
    exec sudo -u "$sb" -i bash -lc "cd $(printf '%q' "$cwd") && exec $agent_cmd$extra_q"
}

cmd_run() {
    local here="" arg
    while [[ $# -gt 0 ]]; do
        arg="$1"
        case "$arg" in
            --here) here=1; shift ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    [[ $# -gt 0 ]] || die "usage: asb run [--here] <command...>"
    local sb cmd
    sb=$(current_sandbox)
    # One argument is a command line for the sandbox's shell, so pipes and
    # redirection survive; several are a command plus arguments, quoted.
    if [[ $# -eq 1 ]]; then
        cmd="$1"
    else
        cmd=$(printf '%q ' "$@")
    fi
    if [[ -n "$here" ]]; then
        local cwd
        cwd=$(pwd -P)
        require_granted "$sb" "$cwd"
        cmd="cd $(printf '%q' "$cwd") && $cmd"
    fi
    exec sudo -u "$sb" -i bash -lc "$cmd"
}

cmd_shell() {
    [[ $# -eq 0 ]] || die "usage: asb shell (to run a single command, use 'asb run')"
    local sb
    sb=$(current_sandbox)
    printf "Entering sandbox '%s' — exit or ^D to leave.\n" "$sb" >&2
    exec sudo -u "$sb" -i
}

cmd_lockdown() {
    info "This will remove group/other permissions from everything under $HOME"
    info "and set 'umask 077' for future files."
    confirm "Proceed?" || die "aborted"
    chmod -R go-rwx "$HOME" 2>/dev/null || warn "some files could not be changed"
    # The chmod above zeroes the ACL mask on any already-granted project under
    # $HOME, so re-apply every sandbox's grants.
    local sb dir
    for sb in $(all_sandboxes); do
        while IFS= read -r dir; do
            if [[ -d "$dir" ]]; then
                apply_grants "$sb" "$dir"
                apply_parent_traverse "$sb" "$dir"
            fi
        done < "$(grant_file "$sb")"
    done
    local marker="# >>> asb lockdown >>>" f files=("$HOME/.bashrc")
    # Login shells read .bash_profile if present (Fedora skel), else .profile.
    if [[ -f "$HOME/.bash_profile" ]]; then
        files+=("$HOME/.bash_profile")
    else
        files+=("$HOME/.profile")
    fi
    if [[ "$OS" == Darwin ]]; then
        files+=("$HOME/.zprofile" "$HOME/.zshrc")
    fi
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || touch "$f"
        if ! grep -qF "$marker" "$f"; then
            printf '\n%s\numask 077\n# <<< asb lockdown <<<\n' "$marker" >> "$f"
            info "umask 077 added to $f"
        fi
    done
    info "Locked down. New shells will create private files by default."
}

cmd_doctor() {
    local ok=0 fail=0
    check() {  # check <label> <cmd...>
        local label="$1"; shift
        if "$@" >/dev/null 2>&1; then
            printf '  ok    %s\n' "$label"; ok=$((ok+1))
        else
            printf '  FAIL  %s\n' "$label"; fail=$((fail+1))
        fi
    }
    info "asb doctor"
    if [[ "$OS" == Darwin ]]; then
        check "macOS account tools available" command -v sysadminctl
        check "directory services available" command -v dscl
    else
        check "setfacl available" command -v setfacl
        check "getfacl available" command -v getfacl
        check "useradd available (needed for 'asb create')" command -v useradd
    fi
    check "sudo available" command -v sudo

    # ACL round-trip on the current filesystem
    local probe
    probe=$(mktemp "$PWD/.asb-doctor.XXXXXX" 2>/dev/null) || probe=""
    if [[ -n "$probe" ]]; then
        if [[ "$OS" == Darwin ]]; then
            if chmod +a "user:$USER allow read" "$probe" 2>/dev/null &&
               grep -Fq "user:$USER allow read" <<< "$(ls -lde "$probe" 2>/dev/null)"; then
                printf '  ok    filesystem at %s supports macOS ACLs\n' "$PWD"; ok=$((ok+1))
            else
                printf '  FAIL  filesystem at %s does not support macOS ACLs\n' "$PWD"; fail=$((fail+1))
            fi
        else
            if setfacl -m "u:$USER:r" "$probe" 2>/dev/null &&
               grep -q "user:$USER" <<< "$(getfacl "$probe" 2>/dev/null)"; then
                printf '  ok    filesystem at %s supports POSIX ACLs\n' "$PWD"; ok=$((ok+1))
            else
                printf '  FAIL  filesystem at %s does not support POSIX ACLs (NFS/FAT?)\n' "$PWD"; fail=$((fail+1))
            fi
        fi
        rm -f "$probe"
    fi

    local sb
    for sb in $(all_sandboxes); do
        check "sandbox '$sb': OS account exists" id "$sb"
        check "sandbox '$sb': passwordless switch works" sudo -n -u "$sb" true
        local agent bin installer
        agent=$(default_agent_for "$sb" 2>/dev/null || true)
        [[ -n "$agent" ]] || continue
        bin=$(agent_binary "$agent" 2>/dev/null || true)
        [[ -n "$bin" ]] || continue
        if sandbox_sh -n "$sb" "command -v $(printf '%q' "$bin")" >/dev/null 2>&1; then
            printf "  ok    sandbox '%s': agent '%s' resolvable (%s)\n" "$sb" "$agent" "$bin"
            ok=$((ok+1))
        else
            printf "  FAIL  sandbox '%s': agent '%s' not installed (%s)\n" "$sb" "$agent" "$bin"
            fail=$((fail+1))
            installer=$(agent_installer "$bin")
            printf "        install it with: asb -s %s run '%s'\n" "$sb" "${installer:-<install command>}"
        fi
    done
    printf '%d ok, %d failed\n' "$ok" "$fail"
    [[ "$fail" -eq 0 ]]
}

# ---------------------------------------------------------------- dispatch

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--sandbox) SANDBOX_OVERRIDE="${2:-}"; shift 2 || die "-s needs a sandbox name" ;;
            -y|--yes) ASSUME_YES=1; shift ;;
            -h|--help) usage; exit 0 ;;
            --version) printf 'asb %s\n' "$ASB_VERSION"; exit 0 ;;
            -*) die "unknown option: $1 (see asb --help)" ;;
            *) break ;;
        esac
    done
    local cmd="${1:-}"
    [[ -n "$cmd" ]] && shift
    ensure_config
    case "$cmd" in
        create)   cmd_create "$@" ;;
        delete)   cmd_delete "$@" ;;
        use)      cmd_use "$@" ;;
        list)     cmd_list "$@" ;;
        add)      cmd_add "$@" ;;
        remove)   cmd_remove "$@" ;;
        recover)  cmd_recover "$@" ;;
        launch)   cmd_launch "$@" ;;
        run)      cmd_run "$@" ;;
        shell)    cmd_shell "$@" ;;
        lockdown) cmd_lockdown "$@" ;;
        doctor)   cmd_doctor "$@" ;;
        ""|help)  usage ;;
        *)        die "unknown command: $cmd (see asb --help)" ;;
    esac
}

main "$@"
